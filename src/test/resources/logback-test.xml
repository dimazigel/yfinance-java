<?xml version="1.0" encoding="UTF-8"?>
<!-- Test-suite logging: Logback rather than slf4j-simple because the latter's MDC adapter is a no-op,
     which would make the LogContext tests meaningless. WARN and above only, in the pattern the README
     documents so the MDC keys and key-value pairs are visible when something does go wrong. -->
<configuration>
  <appender name="STDERR" class="ch.qos.logback.core.ConsoleAppender">
    <target>System.err</target>
    <encoder>
      <pattern>%-5level [%X{yf.op}] %X{yf.symbol} %X{yf.endpoint} %logger{0} - %msg %kvp%n</pattern>
    </encoder>
  </appender>
  <root level="WARN">
    <appender-ref ref="STDERR"/>
  </root>
</configuration>
